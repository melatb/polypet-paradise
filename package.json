{
  "name": "polypet-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:single": "tsc -b && vite build --mode single",
    "typecheck": "tsc -b",
    "build:artifact": "npm run build:single && node scripts/artifact.mjs",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project polypet-rules-test 'vitest run --config vitest.rules.config.ts'"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
